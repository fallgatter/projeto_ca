{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integração do cenário de Curitiba v1",
  "oneOf": [
    {"$ref": "#/$defs/frame"}, {"$ref": "#/$defs/sensors"}, {"$ref": "#/$defs/flow"},
    {"$ref": "#/$defs/journeys"}, {"$ref": "#/$defs/window"}, {"$ref": "#/$defs/command"},
    {"$ref": "#/$defs/comparison"}
  ],
  "$defs": {
    "number": {"type": "number", "minimum": 0},
    "counter": {"type": "integer", "minimum": 0},
    "point": {"type": "array", "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}], "items": false, "minItems": 2},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "header": {
      "type": "object",
      "required": ["schema_version", "kind"],
      "properties": {"schema_version": {"const": "1.0"}, "kind": {"type": "string"}}
    },
    "sensor": {
      "type": "object", "required": ["sensor_id", "state", "vehicle_speed_kmh"],
      "properties": {
        "sensor_id": {"type": "string"}, "state": {"enum": ["occupied", "free"]},
        "vehicle_speed_kmh": {"type": ["number", "null"], "minimum": 0}, "mode": {"enum": ["cars", "buses"]}
      }
    },
    "phase": {
      "type": "object", "required": ["phase_index", "lamp_state", "next_switch_s"],
      "properties": {"phase_index": {"$ref": "#/$defs/counter"}, "lamp_state": {"type": "string"}, "next_switch_s": {"$ref": "#/$defs/number"}}
    },
    "sensors": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["timestamp", "run_id", "intersection_id", "sensors", "instantaneous_metrics", "signals"],
      "properties": {
        "kind": {"const": "intersection.sensors"}, "timestamp": {"$ref": "#/$defs/timestamp"},
        "run_id": {"type": "string"}, "intersection_id": {"type": "string"}, "observed_s": {"$ref": "#/$defs/counter"},
        "sensors": {"type": "array", "items": {"$ref": "#/$defs/sensor"}},
        "signals": {"type": "object", "additionalProperties": {"$ref": "#/$defs/phase"}},
        "instantaneous_metrics": {
          "type": "object", "required": ["queue_length_meters", "co2_grams_per_second"],
          "properties": {"queue_length_meters": {"$ref": "#/$defs/number"}, "co2_grams_per_second": {"$ref": "#/$defs/number"}}
        }
      }
    },
    "trip": {
      "type": "object", "required": ["completed", "travel_s", "delay_s"],
      "properties": {"completed": {"$ref": "#/$defs/counter"}, "travel_s": {"$ref": "#/$defs/number"}, "delay_s": {"$ref": "#/$defs/number"},
                     "mean_travel_s": {"type": ["number", "null"], "minimum": 0}, "mean_delay_s": {"type": ["number", "null"], "minimum": 0}}
    },
    "trips": {
      "type": "object", "required": ["cars", "buses", "bicycles"], "additionalProperties": {"$ref": "#/$defs/trip"}
    },
    "mass": {
      "type": "object", "required": ["co2", "co", "nox", "hc", "pmx"], "additionalProperties": {"$ref": "#/$defs/number"}
    },
    "mass_by_mode": {
      "type": "object", "required": ["cars", "buses"], "additionalProperties": {"$ref": "#/$defs/mass"}
    },
    "crossing": {
      "type": "object", "required": ["passages", "peak_queue_m", "energy_seconds", "peak_energy"],
      "properties": {"passages": {"$ref": "#/$defs/counter"}, "peak_queue_m": {"$ref": "#/$defs/number"},
                     "energy_seconds": {"$ref": "#/$defs/number"}, "peak_energy": {"$ref": "#/$defs/number"},
                     "queue_now_m": {"$ref": "#/$defs/number"}, "co2_now_g_s": {"$ref": "#/$defs/number"},
                     "sensors": {"type": "array", "items": {"$ref": "#/$defs/sensor"}},
                     "laeq_dba": {"type": ["number", "null"]}, "lp_peak_dba": {"type": ["number", "null"]}}
    },
    "frame": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["timestamp", "start_s", "end_s", "trips", "mass_kg", "intersections", "pedestrian_passages", "active", "buses", "teleports"],
      "properties": {
        "kind": {"const": "simulation.frame"}, "timestamp": {"$ref": "#/$defs/timestamp"},
        "start_s": {"$ref": "#/$defs/counter"}, "end_s": {"$ref": "#/$defs/counter"},
        "trips": {"$ref": "#/$defs/trips"}, "mass_kg": {"$ref": "#/$defs/mass_by_mode"},
        "intersections": {"type": "object", "additionalProperties": {"$ref": "#/$defs/crossing"}},
        "pedestrian_passages": {"type": "object", "additionalProperties": {"$ref": "#/$defs/counter"}},
        "active": {"type": "object", "additionalProperties": {"$ref": "#/$defs/counter"}},
        "traffic_cells": {"type": "object", "patternProperties": {"^[0-9]+$": {"$ref": "#/$defs/counter"}}, "additionalProperties": false},
        "cars": {"type": "array", "items": {"type": "object", "required": ["id", "coordinates"],
                   "properties": {"id": {"type": "string"}, "coordinates": {"$ref": "#/$defs/point"}}}},
        "buses": {"type": "array", "items": {"type": "object", "required": ["id", "line_id", "coordinates"],
                   "properties": {"id": {"type": "string"}, "line_id": {"type": ["string", "null"]}, "coordinates": {"$ref": "#/$defs/point"}}}},
        "teleports": {"$ref": "#/$defs/counter"},
        "online_control": {
          "type": "object",
          "required": ["online_updates", "online_policy_changes", "online_explorations"],
          "properties": {
            "online_updates": {"$ref": "#/$defs/counter"},
            "online_policy_changes": {"$ref": "#/$defs/counter"},
            "online_explorations": {"$ref": "#/$defs/counter"}
          }
        },
        "signals": {"type": "object", "additionalProperties": {"$ref": "#/$defs/phase"}}
      }
    },
    "window": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["run_id", "start_s", "end_s", "duration_s", "trips", "mass_kg", "mass_by_mode_kg", "intersections", "peak_queue_m"],
      "properties": {
        "kind": {"const": "window.summary"}, "run_id": {"type": "string"},
        "start_s": {"$ref": "#/$defs/counter"}, "end_s": {"$ref": "#/$defs/counter"}, "duration_s": {"$ref": "#/$defs/counter"},
        "trips": {"$ref": "#/$defs/trips"}, "mass_kg": {"$ref": "#/$defs/mass"}, "mass_by_mode_kg": {"$ref": "#/$defs/mass_by_mode"},
        "intersections": {"type": "object", "additionalProperties": {"$ref": "#/$defs/crossing"}}, "peak_queue_m": {"$ref": "#/$defs/number"}
      }
    },
    "flow": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["observations", "errors"],
      "properties": {
        "kind": {"const": "tomtom.flow"}, "source": {"type": "string"}, "errors": {"type": "array"},
        "observations": {"type": "array", "items": {
          "type": "object", "required": ["observed_at", "query", "coordinates", "speed_kmh", "free_speed_kmh", "travel_time_s", "free_travel_time_s", "confidence", "closed"],
          "properties": {"observed_at": {"$ref": "#/$defs/timestamp"}, "query": {"$ref": "#/$defs/point"},
                         "coordinates": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 2},
                         "speed_kmh": {"$ref": "#/$defs/number"}, "free_speed_kmh": {"$ref": "#/$defs/number"},
                         "travel_time_s": {"$ref": "#/$defs/number"}, "free_travel_time_s": {"$ref": "#/$defs/number"},
                         "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "closed": {"type": "boolean"}}
        }}
      }
    },
    "journeys": {
      "allOf": [{"$ref": "#/$defs/header"}], "required": ["journeys"],
      "properties": {
        "kind": {"const": "urbs.journeys"},
        "journeys": {"type": "array", "items": {"type": "object", "required": ["id", "vehicle_id", "line_id", "observed_start_s", "observed_end_s", "gps_points", "mapped_points", "median_error_m"],
          "properties": {"id": {"type": "string"}, "vehicle_id": {"type": "string"}, "line_id": {"type": "string"},
                         "observed_start_s": {"$ref": "#/$defs/counter"}, "observed_end_s": {"$ref": "#/$defs/counter"},
                         "gps_points": {"$ref": "#/$defs/counter"}, "mapped_points": {"$ref": "#/$defs/counter"}, "median_error_m": {"$ref": "#/$defs/number"}}}}
      }
    },
    "command": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["timestamp", "run_id", "signal_id", "phase_index", "seconds", "observed_s", "next_switch_s"],
      "properties": {
        "kind": {"const": "signal.extend_green"}, "timestamp": {"$ref": "#/$defs/timestamp"}, "run_id": {"type": "string"},
        "signal_id": {"type": "string"}, "phase_index": {"$ref": "#/$defs/counter"},
        "seconds": {"type": "integer", "minimum": 1, "maximum": 5},
        "observed_s": {"$ref": "#/$defs/counter"}, "next_switch_s": {"$ref": "#/$defs/number"}
      }
    },
    "comparison_kpis": {
      "type": "object", "required": ["delay_s", "travel_s", "speed_kmh", "mean_queue_m", "peak_queue_m",
                                    "completed", "brt_matched", "brt_matched_delay_s", "co2", "co", "nox", "hc", "pmx", "laeq_dba"],
      "additionalProperties": {"type": ["number", "null"]}
    },
    "comparison": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["run_id", "baseline_run", "strategy", "receivers", "baseline", "adaptive"],
      "properties": {
        "kind": {"const": "signal.comparison"}, "run_id": {"type": "string"}, "baseline_run": {"type": "string"},
        "strategy": {"type": "string"}, "eco_approach": {"type": "boolean"}, "receivers": {"$ref": "#/$defs/counter"},
        "baseline": {"$ref": "#/$defs/comparison_kpis"}, "adaptive": {"$ref": "#/$defs/comparison_kpis"}
      }
    }
  }
}
